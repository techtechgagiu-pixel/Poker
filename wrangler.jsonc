{
  "name": "ai-poker-night",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "STATIC", "bucket_name": "poker-static" }],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "PokerRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerRoom"] }],
  "routes": [{ "pattern": "poker.noventra.ro", "custom_domain": true }]
}
